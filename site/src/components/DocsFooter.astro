---
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Default />
<aside class="sortie-colophon" aria-label="About this site">
	<p>
		<strong>Sortie is built in collaboration with AI.</strong> The code, documentation and the optional Field Notes
		magazine are written with AI assistance.
	</p>
	<p class="sortie-colophon-links">
		<a href={base}>Sortie home</a>
		<a href="https://github.com/sortie-launcher/sortie/releases">Releases</a>
		<a class="zines" href="https://sortie-launcher.github.io/sortie-zines/">Field Notes reader</a>
		<a href="https://github.com/sortie-launcher/sortie">Source on GitHub</a>
	</p>
</aside>

<style>
	.sortie-colophon {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.sortie-colophon p {
		margin: 0 0 0.75rem;
		max-width: 38rem;
	}
	.sortie-colophon strong {
		color: var(--sl-color-gray-2);
	}
	.sortie-colophon-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}
	.sortie-colophon-links a {
		color: var(--sl-color-gray-2);
		text-underline-offset: 0.2em;
	}
	.sortie-colophon-links a:hover {
		color: var(--sl-color-text-accent);
	}
	.sortie-colophon-links a.zines {
		color: var(--sortie-zines);
	}
</style>
